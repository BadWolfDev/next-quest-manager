# ---------------------------------------------------------------------------
# Next Quest Manager — the whole configuration surface.
#
# Copy this file to `.env` and fill in both values. There is nothing else to
# configure: no Redis, no object store, no mail provider.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local dev with the bundled compose file (`docker compose up -d db`):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nextquest
#
# Hosted Postgres (Neon, Supabase, Railway, RDS …) usually needs sslmode:
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Use the POOLED endpoint on serverless hosts — the client already sets
# `prepare: false` so PgBouncer/Neon transaction pooling works.

# Session signing secret for Auth.js. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional. Max Postgres connections per process (default 10). Lower it to 1–3
# on serverless platforms that run many concurrent instances.
# DATABASE_POOL_MAX=10
